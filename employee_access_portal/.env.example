# Employee Access Portal - local development template.
#
# Copy to `.env` and fill in real values for LOCAL development only.
# `.env` is git-ignored. Never commit real credentials.
# In Cloud Run these come from environment variables and Google Secret Manager.

# --- Microsoft Entra (non-secret) ---------------------------------------------
# Directory (tenant) ID GUID of the SINGLE tenant that owns the employee accounts.
# Must be a tenant GUID. "common", "organizations" and "consumers" are rejected.
ENTRA_PORTAL_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the Entra app registration for THIS portal.
# This app registration must be separate from the ServiceDesk AI Graph app.
ENTRA_PORTAL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Microsoft Entra (secret) -------------------------------------------------
# Client secret VALUE of the portal app registration.
# Local development only. In Cloud Run this is injected from Secret Manager
# (secret name: servicedesk-entra-portal-client-secret).
ENTRA_PORTAL_CLIENT_SECRET=replace-with-local-dev-secret-value

# --- Portal ------------------------------------------------------------------
# Public origin of this portal, with no trailing slash.
# The Entra redirect URI is always <PORTAL_BASE_URL>/auth/redirect
# Local:      http://localhost:8080
# Cloud Run:  https://<service>-<hash>-<region>.a.run.app
PORTAL_BASE_URL=http://localhost:8080

# Session encryption secret: >= 32 characters of high-entropy random data.
# Generate with: openssl rand -base64 48
# In Cloud Run this is injected from Secret Manager
# (secret name: servicedesk-entra-portal-session-secret).
PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Optional ----------------------------------------------------------------
# Cloud Run injects PORT automatically. Defaults to 8080.
# PORT=8080
