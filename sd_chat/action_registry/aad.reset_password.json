{
  "id": "aad.reset_password",
  "title": "Reset Azure AD password for a user",
  "description": "Reset a user's Azure Active Directory password via Microsoft Graph and force change at next sign-in.",
  "inputs": ["target_upn"],
  "outputs": ["reset.status", "reset.message"],
  "preconditions": ["caller_is_self_or_manager"],
  "effects": ["password_reset(${target_upn})"],
  "tool": "aad_tool",
  "action": "reset_password",
  "args_template": {
    "target_upn": "${target_upn}",
    "mode": "force_change_on_next_login"
  }
}
