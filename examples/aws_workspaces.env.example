# Safe default. Real client validation must explicitly set aws.
AWS_WORKSPACES_MODE=off

# Local file containing explicit Entra UPN -> WorkSpaces directory-user mappings.
AWS_WORKSPACES_USER_MAP_PATH=/secure/local/path/workspaces_user_map.json

# Used only when AWS_WORKSPACES_MODE=demo.
AWS_WORKSPACES_DEMO_FIXTURE_PATH=tests/fixtures/aws_workspaces_demo.json

# Recent CloudWatch window, clamped by the tool to 5..1440 minutes.
AWS_WORKSPACES_METRIC_LOOKBACK_MINUTES=30

# AWS credentials are intentionally absent. boto3 uses its standard provider chain.
AWS_PROFILE=read-only-workspaces
